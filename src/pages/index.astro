---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RadarCard from '../components/RadarCard.astro';
import StateBadge from '../components/StateBadge.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import RequestForm from '../components/RequestForm.astro';
import EpisodeFlow from '../components/EpisodeFlow.astro';
import { formatDate, recommendationLabels, toIsoDate, type Recommendation } from '../lib/content';

const radar: CollectionEntry<'radar'>[] = await getCollection('radar');
radar.sort((a: CollectionEntry<'radar'>, b: CollectionEntry<'radar'>) => a.data.order - b.data.order);
const featured = radar.find((item) => item.data.featured) ?? radar[0];
const recentRadar = [...radar].sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()).slice(0, 3);
const records: CollectionEntry<'registro'>[] = await getCollection('registro', ({ data }) => !data.draft);
records.sort((a: CollectionEntry<'registro'>, b: CollectionEntry<'registro'>) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const videos: CollectionEntry<'videos'>[] = await getCollection('videos');
videos.sort((a: CollectionEntry<'videos'>, b: CollectionEntry<'videos'>) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const currentVideo = videos[0];
const counts = (Object.keys(recommendationLabels) as Recommendation[]).map((recommendation) => ({
  recommendation,
  label: recommendationLabels[recommendation],
  count: radar.filter((item) => item.data.recommendation === recommendation).length,
}));
---

<BaseLayout title="rogpLabs" description="Laboratório público da ROGPE para testar tecnologia, registrar decisões e transformar perguntas da comunidade em novos experimentos.">
  <section class="home-hero section-pad">
    <div class="container hero-grid">
      <div class="hero-copy-block">
        <span class="eyebrow"><i aria-hidden="true"></i> laboratório aberto</span>
        <h1>Tecnologia que<br /><em>a gente testa junto.</em></h1>
        <p class="lead">O rogpLabs publica o processo: hipótese, teste, evidência e mudança de decisão. Sem contador decorativo e sem esconder o que ainda não sabemos.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/radar/">Explorar o radar <span aria-hidden="true">→</span></a>
          <a class="text-link" href="#participar">Propor uma investigação</a>
        </div>
      </div>
      <article class="now-card">
        <div class="now-topline">
          <span class="eyebrow">agora no laboratório</span>
          <time datetime={toIsoDate(featured.data.updatedAt)}>{formatDate(featured.data.updatedAt, 'short')}</time>
        </div>
        <StateBadge recommendation={featured.data.recommendation} />
        <h2>{featured.data.title}</h2>
        <p>{featured.data.summary}</p>
        <dl>
          <div><dt>Critério</dt><dd>{featured.data.decisionCriteria}</dd></div>
          <div><dt>Próximo passo</dt><dd>{featured.data.nextStep}</dd></div>
        </dl>
        <a class="card-action" href={`/radar/${featured.id}/`}>Ler a decisão e as evidências <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="radar-summary section-pad" aria-labelledby="radar-summary-title">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">radar em resumo</span><h2 id="radar-summary-title">Cada posição precisa explicar o porquê.</h2></div>
        <p>Os estados mudam quando a evidência muda. A página do item registra o critério, as fontes e o próximo teste.</p>
      </div>
      <div class="count-strip" aria-label="Quantidade de itens por recomendação">
        {counts.map((item) => <a href={`/radar/?estado=${item.recommendation}`}><strong>{String(item.count).padStart(2, '0')}</strong><span>{item.label}</span></a>)}
      </div>
      <div class="radar-preview">
        {recentRadar.map((item) => <RadarCard item={item} compact />)}
      </div>
      <a class="button button-secondary section-action" href="/radar/">Ver todos os itens do radar</a>
    </div>
  </section>

  <section class="record-preview section-pad" aria-labelledby="record-title">
    <div class="container record-grid">
      <div class="section-heading stacked">
        <div><span class="eyebrow">registro do laboratório</span><h2 id="record-title">O que mudou e o que vem depois.</h2></div>
        <p>Notas curtas, datadas e ligadas às decisões do radar.</p>
        <a class="text-link" href="/registro/">Abrir o registro completo <span aria-hidden="true">→</span></a>
      </div>
      <ol class="record-list">
        {records.slice(0, 3).map((record) => (
          <li>
            <time datetime={toIsoDate(record.data.publishedAt)}>{formatDate(record.data.publishedAt, 'short')}</time>
            <div><span>{record.data.kind}</span><h3><a href={`/registro/${record.id}/`}>{record.data.title}</a></h3><p>{record.data.summary}</p></div>
            <a href={`/registro/${record.id}/`} aria-label={`Ler registro: ${record.data.title}`}>↗</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="participation section-pad" id="participar" aria-labelledby="participation-title">
    <div class="container participation-grid">
      <div>
        <span class="eyebrow eyebrow-inverse">youtube é parte do laboratório</span>
        <h2 id="participation-title">Cada vídeo continua depois do play.</h2>
        <p>O canal mostra o experimento. O site guarda as referências, a decisão e as perguntas que seguem abertas.</p>
        <a class="button button-inverse" href="https://www.youtube.com/@rodolfog.peixoto" target="_blank" rel="noreferrer">Abrir o canal <span aria-hidden="true">↗</span></a>
      </div>
      {currentVideo && <EpisodeFlow video={currentVideo} />}
    </div>
  </section>

  <section class="request-section section-pad" id="pedidos" aria-labelledby="request-title">
    <div class="container request-grid">
      <div>
        <span class="eyebrow">fila pública</span>
        <h2 id="request-title">O que vale investigar agora?</h2>
        <p>Escreva a pergunta e escolha um formato. O pedido abre no GitHub para você revisar antes de publicar e para a comunidade acompanhar.</p>
        <a class="text-link" href="https://github.com/rogpetechorg/rogplabs/discussions" target="_blank" rel="noreferrer">Prefere conversar primeiro? Use as Discussões <span aria-hidden="true">↗</span></a>
      </div>
      <RequestForm />
    </div>
  </section>

  <section class="learning-section section-pad" aria-labelledby="learning-title">
    <div class="container learning-grid">
      <div><span class="eyebrow">trilhas em preparação</span><h2 id="learning-title">Cursos nascem dos testes, não de uma promessa vazia.</h2></div>
      <div class="learning-list">
        <span>Inteligência Artificial para devs</span>
        <span>Inteligência Artificial para negócios</span>
        <span>Programação com IA</span>
        <p>As primeiras turmas ainda não estão abertas. O briefing avisará quando houver programa, formato e data confirmados.</p>
      </div>
    </div>
  </section>

  <section class="request-section section-pad" aria-labelledby="partnership-title">
    <div class="container request-grid"><div><span class="eyebrow">projetos e parcerias</span><h2 id="partnership-title">Uma pergunta pode virar o próximo experimento.</h2><p>Examine nossos registros públicos e converse com o laboratório sobre uma parceria ou demanda. Definimos a pergunta, o escopo e a evidência esperada antes de começar.</p></div><div class="hero-actions"><a class="button button-primary" href="/projetos/">Ver projetos e evidências</a><a class="text-link" href="/contato/">Conversar com o rogpLabs</a></div></div>
  </section>

  <section class="newsletter-section section-pad" id="newsletter" aria-labelledby="newsletter-title">
    <div class="container newsletter-grid">
      <div><span class="eyebrow eyebrow-inverse">briefing do laboratório</span><h2 id="newsletter-title">Uma vez por semana, o que vale acompanhar.</h2><p>Experimentos, decisões, próximos roteiros e uma pergunta que ainda não fechamos.</p></div>
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
