---
import '../styles/global.css';

const decisions = {
  adotar: { label: 'Adotar agora', title: 'Coding com IA e gates reais', description: 'Já usamos quando existe teste, revisão e uma regra clara para parar.', criterion: 'Pronto para projetos com avaliação e responsabilidade definida.' },
  testar: { label: 'Em teste', title: 'Agentes com memória verificável', description: 'Comparar recuperação, custo e controle humano antes de escalar.', criterion: 'Experimente em escopo controlado e registre o que mudou.' },
  acompanhar: { label: 'Acompanhar', title: 'Interfaces que explicam IA', description: 'A ideia é promissora, mas ainda precisa de evidência em uso real.', criterion: 'Observe evolução, casos concretos e limites antes de investir.' },
  naoAdotar: { label: 'Não adotar', title: 'RAG genérico sem avaliação', description: 'Sem uma avaliação que sustente a resposta, a promessa não se mantém.', criterion: 'Não use por enquanto. Volte apenas com um método de avaliação.' },
};

const radar = [
  { number: '01', title: 'Agentes com memória verificável', state: 'testar', group: 'tecnicas', x: 73, y: 66, note: 'Comparar recuperação, custo e controle humano antes de escalar.', criterion: 'Experimente em escopo controlado e registre o resultado.' },
  { number: '02', title: 'Interfaces que explicam IA', state: 'acompanhar', group: 'tecnicas', x: 82, y: 31, note: 'Prototipar interfaces que mostram fonte, limite e próxima ação.', criterion: 'Acompanhe casos de uso antes de investir em uma plataforma.' },
  { number: '03', title: 'MCP com princípio de menor acesso', state: 'testar', group: 'ferramentas', x: 29, y: 52, note: 'Testar conectores pequenos, auditáveis e com permissões explícitas.', criterion: 'Teste com permissões mínimas e rastreabilidade.' },
  { number: '04', title: 'RAG genérico sem avaliação', state: 'naoAdotar', group: 'tecnicas', x: 24, y: 72, note: 'Sem avaliação, não há sinal suficiente para sustentar o uso.', criterion: 'Não adote até existir um conjunto de avaliação relevante.' },
  { number: '05', title: 'Coding com IA e gates reais', state: 'adotar', group: 'tecnicas', x: 64, y: 84, note: 'Usar com testes, revisão e escopo claro. Velocidade sem sinal não conta.', criterion: 'Já pode entrar em projetos com revisão e testes estabelecidos.' },
  { number: '06', title: 'Browser automation com supervisão', state: 'acompanhar', group: 'ferramentas', x: 74, y: 76, note: 'Mapear riscos e casos seguros antes de levar a tarefas de produção.', criterion: 'Acompanhe os controles de segurança antes de colocar em operação.' },
];

const agenda = [
  { date: '18 SET', type: 'vídeo', title: 'Quando um agente precisa saber a hora de parar', copy: 'Roteiro aberto para perguntas e contrapontos.', status: 'roteiro aberto' },
  { date: '25 SET', type: 'experimento', title: 'Memória verificável sem virar uma caixa-preta', copy: 'Comparativo de recuperação, custo e supervisão.', status: 'em preparação' },
  { date: '02 OUT', type: 'conversa', title: 'Como aprender IA sem pular os fundamentos', copy: 'Uma pauta guiada pelas perguntas da comunidade.', status: 'recebendo pedidos' },
];

const courses = [
  { number: '01', title: 'Inteligência Artificial para devs', copy: 'Ferramentas, avaliação e contexto para usar IA no trabalho de engenharia.', state: 'em breve' },
  { number: '02', title: 'Inteligência Artificial para negócios', copy: 'Decisões, processos e experimentos que conectam IA a resultado real.', state: 'em breve' },
  { number: '03', title: 'Programação com IA', copy: 'Um percurso prático para construir, revisar e operar software com IA.', state: 'em breve' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="rogpLabs é um laboratório público para testar tecnologias, criar vídeos e aprender IA com a comunidade." />
    <meta name="theme-color" content="#f7f8f6" />
    <link rel="canonical" href="https://rogplabs.rogpe.tech/" />
    <meta property="og:site_name" content="rogpLabs" />
    <meta property="og:title" content="rogpLabs | Tecnologia em público" />
    <meta property="og:description" content="Um laboratório aberto para decidir o que adotar, testar, acompanhar ou deixar de lado." />
    <title>rogpLabs | Tecnologia em público</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="rogpLabs, início"><strong>rogp<span>Labs</span></strong><small>tecnologia<br />em público</small></a>
        <nav class="site-nav" aria-label="Principal"><a href="#radar">Radar</a><a href="#programacao">Programação</a><a href="#cursos">Cursos</a><a href="#comunidade">Comunidade</a></nav>
        <a class="button button--primary" href="#newsletter">Entrar na lista ↗</a>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy-block">
            <p class="eyebrow">radar de tecnologias</p>
            <h1 id="hero-title">Decisões melhores<br />para <em>um futuro real.</em></h1>
            <p class="hero-lead">O rogpLabs testa tecnologias, métodos e ferramentas com experiência prática. Aqui você encontra o que vale adotar, testar, acompanhar ou deixar de lado.</p>
            <div class="hero-actions"><a class="button button--primary" href="#radar">Explorar o radar ↓</a><a class="button button--ghost" href="#pedidos">Pedir um vídeo</a></div>
            <ul class="hero-principles" aria-label="Critérios do laboratório"><li>Experiência real em projetos públicos</li><li>Análises com contexto e transparência</li><li>Foco no que gera valor</li></ul>
          </div>

          <section class="signal-console" aria-labelledby="signal-title">
            <div class="signal-console__top"><h2 id="signal-title">Sinal vivo</h2><span><i aria-hidden="true"></i> atualizado hoje</span></div>
            <div class="signal-console__content" aria-live="polite"><p data-signal-label>Em teste</p><h3 data-signal-title>Agentes com memória verificável</h3><p data-signal-description>Comparar recuperação, custo e controle humano antes de escalar.</p></div>
            <div class="signal-options" aria-label="Ler uma recomendação por estado">
              {Object.entries(decisions).map(([key, item]) => <button type="button" class: is-active={key === 'testar'} data-signal-choice={key} aria-pressed={key === 'testar' ? 'true' : 'false'}><span>{item.label}</span><small>{key === 'adotar' ? 'usar em projetos' : key === 'testar' ? 'testar com limites' : key === 'acompanhar' ? 'observar evolução' : 'evitar por enquanto'}</small></button>)}
            </div>
            <div class="signal-console__foot"><p data-signal-criterion>Experimente em escopo controlado e registre o que mudou.</p><a class="text-link" href="#radar">Ver no radar</a></div>
          </section>
        </div>
      </section>

      <section class="pulse-strip" aria-label="Estado atual do laboratório"><div class="container"><p>Um laboratório aberto: o sinal muda quando a evidência muda.</p><div><strong>06</strong>experimentos visíveis</div><div><strong>03</strong>próximos encontros</div><div><strong>01</strong>decisão para adotar</div></div></section>

      <section class="manifesto" aria-labelledby="manifesto-title"><div class="container manifesto-grid"><p class="section-label">o jeito rogpLabs</p><div class="manifesto-copy"><p id="manifesto-title">Testar é mais útil quando deixa rastro.</p><p>Não queremos montar uma vitrine de novidades. Queremos abrir o processo: hipótese, experimento, evidência e decisão. Você acompanha vídeos, roteiros e atualizações. Também pode trazer uma pergunta boa.</p><a class="text-link" href="#comunidade">Entender como participar</a></div></div></section>

      <section class="radar-section" id="radar" aria-labelledby="radar-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-kicker">radar do laboratório</p><h2 id="radar-title">Um mapa para decidir<br />o que merece entrar.</h2></div><p>Os anéis organizam o nível de confiança. Cada bolinha mostra uma recomendação e o critério que levou a ela.</p></div>
          <div class="radar-controls" aria-label="Filtrar itens do radar"><button class="radar-filter is-active" type="button" data-radar-filter="todos">Todos · 6</button><button class="radar-filter" type="button" data-radar-filter="adotar">Adotar agora · 1</button><button class="radar-filter" type="button" data-radar-filter="testar">Em teste · 2</button><button class="radar-filter" type="button" data-radar-filter="acompanhar">Acompanhar · 2</button><button class="radar-filter" type="button" data-radar-filter="naoAdotar">Não adotar · 1</button></div>
          <div class="radar-layout">
            <div class="radar-map" aria-label="Mapa de adoção dividido entre técnicas e ferramentas">
              {['tecnicas', 'ferramentas'].map((group) => <section class={`radar-half radar-half--${group}`} aria-label={group === 'tecnicas' ? 'Técnicas e práticas' : 'Ferramentas e plataformas'}><header><strong>{group === 'tecnicas' ? 'Técnicas' : 'Ferramentas'}</strong><span>{group === 'tecnicas' ? 'métodos e práticas' : 'plataformas e serviços'}</span></header><div class="radar-arcs"><span></span><span></span><span></span><span></span>{radar.filter((item) => item.group === group).map((item) => <button type="button" class={`radar-blip ${item.state}`} style={`--x:${item.x}%;--y:${item.y}%`} data-ring={item.state} data-radar-title={item.title} data-radar-note={item.note} data-radar-state={decisions[item.state as keyof typeof decisions].label} data-radar-criterion={item.criterion} aria-label={`${item.title}. Estado: ${decisions[item.state as keyof typeof decisions].label}.`}><span>{item.number}</span></button>)}</div><footer class="radar-scale"><span>não adotar</span><span>acompanhar</span><span>em teste</span><span>adotar agora</span></footer></section>)}
            </div>
            <aside class="radar-detail" aria-live="polite"><p class="detail-eyebrow"><i aria-hidden="true"></i><span data-radar-state>Em teste</span></p><h3 data-radar-title>Agentes com memória verificável</h3><p data-radar-note>Comparar recuperação, custo e controle humano antes de escalar.</p><div class="radar-detail__criterion"><strong>Critério de decisão</strong><p data-radar-criterion>Experimente em escopo controlado e registre o resultado.</p></div><a class="text-link" href="#newsletter">Receber a análise completa</a></aside>
          </div>
        </div>
      </section>

      <section class="work" id="programacao" aria-labelledby="work-title"><div class="container work-grid"><div class="work-intro"><p class="section-label">o que está acontecendo</p><h2 id="work-title">Últimos registros.<br />Próximos testes.</h2><p>O laboratório mistura prática, vídeo e conversa. O calendário não é enfeite: cada encontro aceita uma participação diferente.</p><div class="last-log"><strong>registro mais recente · experimento 017</strong><p>Quando um agente precisa saber a hora de parar: testamos limite explícito de contexto, permissão e tentativas. O próximo passo é comparar esse modelo com uma automação sem regra de parada.</p></div></div><div class="experiment-list"><article class="experiment-card"><span class="experiment-card__number">01</span><div><h3>Memória de agentes com evidência</h3><p>O que entra, o que expira e como a pessoa consegue conferir a recuperação.</p></div><span class="status status--testando">em teste</span></article><article class="experiment-card"><span class="experiment-card__number">02</span><div><h3>Roteiros que nascem de uma pergunta</h3><p>Uma fila pública para ligar comunidade, experimento e episódio.</p></div><span class="status status--aberto">aberto</span></article><article class="experiment-card"><span class="experiment-card__number">03</span><div><h3>Automação com supervisão</h3><p>Limites claros antes de deixar uma ferramenta agir fora do laboratório.</p></div><span class="status status--pausado">em observação</span></article></div></div></section>

      <section class="agenda" aria-labelledby="agenda-title"><div class="container agenda-grid"><div class="agenda-copy"><p class="section-label">agenda aberta</p><h2 id="agenda-title">O que vem nos próximos dias.</h2><p>Assista, traga uma dúvida ou entre cedo na pauta. O registro continua depois de cada encontro.</p></div><div class="agenda-list">{agenda.map((item) => <article class="agenda-item"><time class="agenda-date">{item.date}<span>{item.type}</span></time><div><h3>{item.title}</h3><p>{item.copy}</p></div><span class="status status--aberto">{item.status}</span></article>)}</div></div></section>

      <section class="youtube-section" aria-labelledby="youtube-title"><div class="container youtube-inner"><div class="youtube-copy"><p class="section-label">youtube é parte do laboratório</p><h2 id="youtube-title">Cada vídeo continua depois do play.</h2><p>O YouTube mostra o experimento. Aqui ficam o roteiro, as referências e o que a comunidade levou para o próximo episódio.</p><a class="button button--primary" href="https://www.youtube.com/@rodopeixoto" target="_blank" rel="noreferrer">Abrir o canal ↗</a></div><article class="episode-card"><p>episódio em construção · 018</p><h3>IA não substitui critério técnico.</h3><a href="#pedidos">Uma pergunta pode entrar no roteiro →</a></article></div></section>

      <section class="courses" id="cursos" aria-labelledby="courses-title"><div class="container courses-grid"><div class="courses-copy"><p class="section-label">aprender fazendo</p><h2 id="courses-title">Cursos em desenvolvimento.</h2><p>Antes de abrir matrícula, cada curso ganha uma sequência de vídeos, exercícios e perguntas reais da comunidade.</p></div><div class="courses-list">{courses.map((course) => <article class="course-card"><span class="course-card__index">{course.number}</span><div><h3>{course.title}</h3><p>{course.copy}</p></div><span>{course.state}</span></article>)}</div></div></section>

      <section class="community" id="comunidade" aria-labelledby="community-title"><div class="container community-grid"><div class="community-copy"><p class="section-label">comunidade</p><h2 id="community-title">Não é plateia.<br />É parte do teste.</h2><p>Três portas simples para a conversa não se perder e as ideias boas conseguirem virar algo concreto.</p></div><div class="community-cards"><article class="community-card"><p class="section-label">01</p><h3>Acompanhar</h3><p>Assine o briefing e veja o que mudou, sem depender do algoritmo.</p></article><article class="community-card"><p class="section-label">02</p><h3>Discutir</h3><p>Leve contrapontos e dúvidas para as Discussões do GitHub.</p></article><article class="community-card"><p class="section-label">03</p><h3>Propor</h3><p>Transforme uma curiosidade em pedido de vídeo, teste ou conversa.</p></article><article class="community-card"><p class="section-label">04</p><h3>Construir junto</h3><p>Compartilhe evidências que ajudem uma decisão a melhorar.</p></article></div></div></section>

      <section class="request" id="pedidos" aria-labelledby="request-title"><div class="container request-grid"><div class="request-copy"><p class="section-label">fila pública</p><h2 id="request-title">O que você quer ver a gente investigar?</h2><p>Escreva a pergunta e abra o pedido. A fila fica no GitHub para que todo mundo consiga acompanhar, comentar e votar.</p></div><form class="request-form" data-request-form><label for="request-topic">Sua pergunta<input id="request-topic" name="topic" required minlength="8" placeholder="Ex.: como avaliar se um agente resolveu bem uma tarefa?" /></label><label>Formato que ajudaria mais<select name="format"><option value="Vídeo no YouTube">Vídeo no YouTube</option><option value="Experimento de laboratório">Experimento de laboratório</option><option value="Live ou conversa">Live ou conversa</option></select></label><button class="button button--primary" type="submit">Abrir pedido no GitHub ↗</button><p class="form-status" data-request-status aria-live="polite"></p></form></div></section>

      <section class="newsletter" id="newsletter" aria-labelledby="newsletter-title"><div class="container newsletter-grid"><div class="newsletter-copy"><p class="section-label">briefing do laboratório</p><h2 id="newsletter-title">Uma vez por semana, o que vale acompanhar.</h2><p>Experimentos, decisões, próximos roteiros e uma pergunta que ainda não fechamos.</p></div><form class="newsletter-form" data-newsletter-form><input id="email" name="email" type="email" autocomplete="email" required placeholder="voce@exemplo.com" aria-label="Seu e-mail" /><button class="button button--primary" type="submit">Quero o briefing</button><p class="form-status" data-newsletter-message aria-live="polite"></p></form></div></section>
    </main>

    <footer class="site-footer"><div class="container site-footer__inner"><a class="brand" href="/"><strong>rogp<span>Labs</span></strong></a><p>Laboratório aberto da ROGPE. Construído em público, com espaço para mudar de ideia.</p><div class="footer-links"><a href="https://github.com/rogpetechorg/rogplabs" target="_blank" rel="noreferrer">GitHub</a><a href="https://www.youtube.com/@rodopeixoto" target="_blank" rel="noreferrer">YouTube</a><a href="mailto:labs@rogpe.tech">Contato</a></div></div></footer>

    <script>
      const decisionData = {
        adotar: { label: 'Adotar agora', title: 'Coding com IA e gates reais', description: 'Já usamos quando existe teste, revisão e uma regra clara para parar.', criterion: 'Pronto para projetos com avaliação e responsabilidade definida.' },
        testar: { label: 'Em teste', title: 'Agentes com memória verificável', description: 'Comparar recuperação, custo e controle humano antes de escalar.', criterion: 'Experimente em escopo controlado e registre o que mudou.' },
        acompanhar: { label: 'Acompanhar', title: 'Interfaces que explicam IA', description: 'A ideia é promissora, mas ainda precisa de evidência em uso real.', criterion: 'Observe evolução, casos concretos e limites antes de investir.' },
        naoAdotar: { label: 'Não adotar', title: 'RAG genérico sem avaliação', description: 'Sem uma avaliação que sustente a resposta, a promessa não se mantém.', criterion: 'Não use por enquanto. Volte apenas com um método de avaliação.' },
      };
      const signalChoices = document.querySelectorAll<HTMLButtonElement>('[data-signal-choice]');
      const signalLabel = document.querySelector<HTMLElement>('[data-signal-label]');
      const signalTitle = document.querySelector<HTMLElement>('[data-signal-title]');
      const signalDescription = document.querySelector<HTMLElement>('[data-signal-description]');
      const signalCriterion = document.querySelector<HTMLElement>('[data-signal-criterion]');
      signalChoices.forEach((choice) => choice.addEventListener('click', () => { const key = choice.dataset.signalChoice as keyof typeof decisionData; const item = decisionData[key]; if (!item || !signalLabel || !signalTitle || !signalDescription || !signalCriterion) return; signalChoices.forEach((button) => { const active = button === choice; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); }); signalLabel.textContent = item.label; signalTitle.textContent = item.title; signalDescription.textContent = item.description; signalCriterion.textContent = item.criterion; }));

      const filters = document.querySelectorAll<HTMLButtonElement>('[data-radar-filter]');
      const blips = document.querySelectorAll<HTMLButtonElement>('[data-ring]');
      const radarTitle = document.querySelector<HTMLElement>('[data-radar-title]');
      const radarNote = document.querySelector<HTMLElement>('[data-radar-note]');
      const radarState = document.querySelector<HTMLElement>('[data-radar-state]');
      const radarCriterion = document.querySelector<HTMLElement>('[data-radar-criterion]');
      function selectBlip(blip: HTMLButtonElement) { if (!radarTitle || !radarNote || !radarState || !radarCriterion) return; radarTitle.textContent = blip.dataset.radarTitle ?? ''; radarNote.textContent = blip.dataset.radarNote ?? ''; radarState.textContent = blip.dataset.radarState ?? ''; radarCriterion.textContent = blip.dataset.radarCriterion ?? ''; blips.forEach((item) => item.classList.toggle('is-selected', item === blip)); }
      blips.forEach((blip) => blip.addEventListener('click', () => selectBlip(blip)));
      filters.forEach((filter) => filter.addEventListener('click', () => { const choice = filter.dataset.radarFilter; filters.forEach((item) => item.classList.toggle('is-active', item === filter)); blips.forEach((blip) => blip.classList.toggle('is-muted', choice !== 'todos' && blip.dataset.ring !== choice)); }));

      const requestForm = document.querySelector<HTMLFormElement>('[data-request-form]');
      requestForm?.addEventListener('submit', (event) => { event.preventDefault(); const topic = requestForm.querySelector<HTMLInputElement>('[name="topic"]')?.value.trim(); const format = requestForm.querySelector<HTMLSelectElement>('[name="format"]')?.value; if (!topic || !format) return; const params = new URLSearchParams({ template: 'video-request.yml', title: `[pedido] ${topic}`, tema: topic, formato: format, contexto: 'Proposta enviada pelo rogpLabs. Adicione aqui o contexto, ferramenta ou problema que motivou este pedido.' }); window.open(`https://github.com/rogpetechorg/rogplabs/issues/new?${params.toString()}`, '_blank', 'noopener,noreferrer'); });
      const newsletterForm = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
      newsletterForm?.addEventListener('submit', async (event) => { event.preventDefault(); const input = newsletterForm.querySelector<HTMLInputElement>('input[type="email"]'); const button = newsletterForm.querySelector<HTMLButtonElement>('button[type="submit"]'); const message = document.querySelector<HTMLElement>('[data-newsletter-message]'); if (!input?.checkValidity()) { input?.reportValidity(); return; } if (button) button.disabled = true; if (message) message.textContent = 'Enviando sua inscrição…'; try { const response = await fetch('/api/newsletter/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value, list_uuids: ['00329d73-0df1-435b-ab44-ee105ec9b6a7'] }) }); if (!response.ok) throw new Error('subscription_failed'); if (message) message.textContent = 'Confira seu e-mail para confirmar a inscrição.'; newsletterForm.reset(); } catch { if (message) message.textContent = 'Não foi possível concluir agora. Tente novamente em alguns minutos.'; } finally { if (button) button.disabled = false; } });
    </script>
  </body>
</html>
