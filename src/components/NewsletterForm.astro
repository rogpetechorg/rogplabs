<form class="newsletter-form" data-newsletter-form novalidate>
  <label for="newsletter-email">Seu e-mail</label>
  <div class="form-row">
    <input id="newsletter-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="voce@exemplo.com" />
    <button class="button button-inverse" type="submit">Quero o briefing</button>
  </div>
  <p class="form-note">Você receberá um e-mail de confirmação. Cada edição tem um link para cancelar.</p>
  <p class="form-message" data-newsletter-message aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const message = form.querySelector<HTMLElement>('[data-newsletter-message]');
      if (!input?.checkValidity()) {
        input?.reportValidity();
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = 'Enviando…';
      }
      if (message) message.textContent = 'Enviando sua inscrição…';
      document.dispatchEvent(new CustomEvent('rogplabs:form', { detail: { form: 'newsletter', phase: 'submit' } }));
      try {
        const response = await fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value.trim(), list_uuids: ['00329d73-0df1-435b-ab44-ee105ec9b6a7'] }),
        });
        if (!response.ok) throw new Error('subscription_failed');
        if (message) message.textContent = 'Confira seu e-mail para confirmar a inscrição.';
        form.reset();
        document.dispatchEvent(new CustomEvent('rogplabs:form', { detail: { form: 'newsletter', phase: 'success' } }));
      } catch {
        document.dispatchEvent(new CustomEvent('rogplabs:form', { detail: { form: 'newsletter', phase: 'error', reason: 'server' } }));
        if (message) message.textContent = 'Não foi possível concluir agora. Tente novamente em alguns minutos.';
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'Quero o briefing';
        }
      }
    });
  });
</script>
