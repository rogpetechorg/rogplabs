{
  "name": "rogplabs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "check": "astro check",
    "check:site": "node scripts/verify-site.mjs",
    "test": "node --test test/contracts.test.mjs",
    "start": "node server/server.mjs",
    "check:all": "pnpm test && pnpm run check && pnpm run build && pnpm run check:site",
    "deploy:production": "node scripts/deploy-dokploy.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.2",
    "typescript": "^5.9.2"
  }
}
